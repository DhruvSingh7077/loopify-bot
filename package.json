{
  "name": "loopify-owner-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Telegram-first MVP for the Loopify Owner Assistant.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "bot": "node --dns-result-order=ipv6first node_modules/tsx/dist/cli.mjs src/bot/run.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:production": "node dist/production.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^8.2.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "grammy": "^1.38.3",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
